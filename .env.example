# Local development defaults. Copy to .env and adjust.
# For a quick start, SQLite is used here; for cloud deploy set the Postgres vars.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Database (default to SQLite for zero-config local dev) ---
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Postgres example (used on cloud deploy):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sms
# DB_USER=sms
# DB_PASSWORD=sms
# DB_HOST=localhost
# DB_PORT=5432

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- AI providers (optional; without these the services use deterministic fallbacks) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# HeyGen (avatar video)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=